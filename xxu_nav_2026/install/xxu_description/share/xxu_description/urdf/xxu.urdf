<?xml version="1.0"?>
<robot name="xxu">
  <!--
    XXU 简化模型
    源码中只保留 odom_link、base_link 和 imu_link。
  -->

  <material name="chassis_blue">
    <color rgba="0.10 0.25 0.80 1.0"/>
  </material>
  <material name="imu_green">
    <color rgba="0.0 0.45 0.25 1.0"/>
  </material>

  <!-- odom_link：里程计参考坐标系，作为当前简化 TF 树的根节点。 -->
  <link name="odom_link"/>

  <joint name="odom_joint" type="fixed">
    <parent link="odom_link"/>
    <child link="base_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <!-- base_link：底盘中心坐标系。x 轴向前，y 轴向左，z 轴向上。 -->
  <link name="base_link">
    <!-- 底盘主体：半径 25 cm，高度 20 cm -->
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.25" length="0.20"/>
      </geometry>
      <material name="chassis_blue"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.25" length="0.20"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="12.0"/>
      <inertia ixx="0.1025" ixy="0" ixz="0" iyy="0.1025" iyz="0" izz="0.3750"/>
    </inertial>
  </link>

  <!-- imu_link：IMU 坐标系，直接固定在 base_link 上。 -->
  <link name="imu_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.07 0.05 0.025"/>
      </geometry>
      <material name="imu_green"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.07 0.05 0.025"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.10"/>
      <inertia ixx="0.00004" ixy="0" ixz="0" iyy="0.00006" iyz="0" izz="0.00007"/>
    </inertial>
  </link>

  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/>
    <child link="imu_link"/>
    <origin xyz="0.08 0 0.1125" rpy="0 0 0"/>
  </joint>
</robot>
