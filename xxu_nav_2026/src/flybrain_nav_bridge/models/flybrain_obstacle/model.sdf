<?xml version="1.0" ?>
<sdf version="1.9">
  <model name="flybrain_obstacle">
    <static>false</static>
    <self_collide>false</self_collide>
    <link name="body">
      <inertial>
        <mass>15.0</mass>
        <inertia>
          <ixx>0.40</ixx><iyy>0.40</iyy><izz>0.40</izz>
          <ixy>0.0</ixy><ixz>0.0</ixz><iyz>0.0</iyz>
        </inertia>
      </inertial>
      <collision name="collision">
        <geometry><box><size>0.42 0.42 0.80</size></box></geometry>
        <max_contacts>20</max_contacts>
      </collision>
      <visual name="visual">
        <geometry><box><size>0.42 0.42 0.80</size></box></geometry>
        <material><diffuse>0.85 0.15 0.10 1</diffuse><ambient>0.85 0.15 0.10 1</ambient></material>
      </visual>
      <!-- The contact sensor is on the spawned obstacle, keeping the robot
           description untouched while still yielding physical-collision data. -->
      <sensor name="contact" type="contact">
        <always_on>1</always_on>
        <update_rate>100</update_rate>
        <topic>/benchmark/contacts</topic>
        <contact><collision>collision</collision></contact>
      </sensor>
    </link>
  </model>
</sdf>
