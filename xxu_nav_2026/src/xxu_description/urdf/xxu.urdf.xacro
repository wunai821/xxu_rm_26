<?xml version="1.0"?>
<robot name="xxu" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <!--
    XXU 简化模型
    静态 TF 树：base_footprint -> base_link -> gimbal_link -> mid360_link，另含四个车轮帧。
    动态 TF 树：odom -> base_footprint 由 Small Point-LIO 发布。
  -->

  <xacro:include filename="wheel.urdf.xacro"/>
  <xacro:include filename="livox_mid360.urdf.xacro"/>

  <!--
    尺寸参数（由毫米换算为米）。base_link 位于底盘底面上方 95.19 mm，
    因此底盘实体从 base_link 平面向上延伸到离地 269.49 mm。
  -->
  <xacro:property name="base_radius" value="0.265"/>
  <xacro:property name="base_link_z" value="0.09519"/>
  <xacro:property name="base_top_z" value="0.26949"/>
  <xacro:property name="base_height" value="${base_top_z - base_link_z}"/>
  <xacro:property name="base_mass" value="4.935"/>

  <!-- 云台上的雷达安装位姿，相对于 base_link：(0, 86.37, 193.8) mm。 -->
  <xacro:property name="mid360_x" value="0"/>
  <xacro:property name="mid360_y" value="0.08637"/>
  <xacro:property name="mid360_z" value="0.1938"/>
  <xacro:property name="mid360_xyz" value="${mid360_x} ${mid360_y} ${mid360_z}"/>
  <!--
    标称姿态：雷达位于 +Y 侧并绕 X 轴向车体外侧倾斜约 17°。
    按 ROS 右手坐标系取负 roll；云台自稳/自瞄时应由实时云台姿态发布动态 TF。
  -->
  <xacro:property name="mid360_roll" value="-0.2967059728"/>
  <xacro:property name="mid360_pitch" value="0"/>
  <xacro:property name="mid360_yaw" value="0"/>
  <xacro:property name="mid360_rpy" value="${mid360_roll} ${mid360_pitch} ${mid360_yaw}"/>

  <!-- 全向轮参数 -->
  <xacro:property name="wheel_radius" value="0.0762"/>
  <xacro:property name="wheel_width" value="0.04"/>
  <xacro:property name="wheel_mass" value="0.45"/>
  <!-- 446.55 mm 按相对两轮中心距解释，因此四轮坐标为 ±223.275 mm。 -->
  <xacro:property name="wheel_center_distance" value="0.44655"/>
  <xacro:property name="wheel_spacing" value="${wheel_center_distance / 2}"/>
  <!-- 轮子底部与地面相切：轮心相对 base_link 为 76.2-95.19=-18.99 mm。 -->
  <xacro:property name="wheel_z" value="${wheel_radius - base_link_z}"/>

  <!-- 颜色定义 -->
  <xacro:macro name="solid_material" params="name rgba">
    <material name="${name}">
      <color rgba="${rgba}"/>
    </material>
  </xacro:macro>

  <xacro:solid_material name="chassis_blue" rgba="0.10 0.25 0.80 1.0"/>
  <xacro:solid_material name="wheel_black" rgba="0.15 0.15 0.15 1.0"/>

  <!-- 固定关节宏 -->
  <xacro:macro name="fixed_joint" params="name parent child xyz:='0 0 0' rpy:='0 0 0'">
    <joint name="${name}" type="fixed">
      <parent link="${parent}"/>
      <child link="${child}"/>
      <origin xyz="${xyz}" rpy="${rpy}"/>
    </joint>
  </xacro:macro>


  <!-- 圆柱 link 宏，用于底盘主体 -->
  <xacro:macro name="cylinder_link" params="name radius length mass ixx iyy izz material origin_z:=0">
    <link name="${name}">
      <visual>
        <origin xyz="0 0 ${origin_z}" rpy="0 0 0"/>
        <geometry>
          <cylinder radius="${radius}" length="${length}"/>
        </geometry>
        <material name="${material}"/>
      </visual>
      <collision>
        <origin xyz="0 0 ${origin_z}" rpy="0 0 0"/>
        <geometry>
          <cylinder radius="${radius}" length="${length}"/>
        </geometry>
      </collision>
      <inertial>
        <origin xyz="0 0 ${origin_z}" rpy="0 0 0"/>
        <mass value="${mass}"/>
        <inertia ixx="${ixx}" ixy="0" ixz="0" iyy="${iyy}" iyz="0" izz="${izz}"/>
      </inertial>
    </link>
  </xacro:macro>

  <!-- 盒体 link 宏 -->
  <xacro:macro name="box_link" params="name size mass ixx iyy izz material">
    <link name="${name}">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <box size="${size}"/>
        </geometry>
        <material name="${material}"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <box size="${size}"/>
        </geometry>
      </collision>
      <inertial>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <mass value="${mass}"/>
        <inertia ixx="${ixx}" ixy="0" ixz="0" iyy="${iyy}" iyz="0" izz="${izz}"/>
      </inertial>
    </link>
  </xacro:macro>

  <!-- base_footprint：地面投影原点，odom 直接连接到该帧。base_link 在其上方 -->
  <link name="base_footprint"/>

  <!-- base_link -->
  <xacro:cylinder_link
    name="base_link"
    radius="${base_radius}"
    length="${base_height}"
    mass="${base_mass}"
    ixx="${base_mass * (3 * base_radius * base_radius + base_height * base_height) / 12}"
    iyy="${base_mass * (3 * base_radius * base_radius + base_height * base_height) / 12}"
    izz="${base_mass * base_radius * base_radius / 2}"
    material="chassis_blue"
    origin_z="${base_height / 2}"/>

  <xacro:fixed_joint name="base_footprint_joint" parent="base_footprint" child="base_link" xyz="0 0 ${base_link_z}"/>

  <!--
    gimbal_link 位于车体中心的云台转轴；简化模型暂以固定 TF 表示云台零位。
    雷达在云台 +Y 86.37 mm 处，17° 外倾角放在 gimbal_link -> mid360_link。
  -->
  <link name="gimbal_link"/>
  <xacro:fixed_joint
    name="gimbal_joint"
    parent="base_link"
    child="gimbal_link"
    xyz="0 0 ${mid360_z}"/>

  <!-- Rigid, level virtual body used by gimbal-motion-compensated LIO. -->
  <link name="lio_base_sensor"/>
  <xacro:fixed_joint
    name="lio_base_sensor_joint"
    parent="base_link"
    child="lio_base_sensor"
    xyz="0 0 ${mid360_z}"/>

  <!-- 与 Gazebo 模型共用同一套 MID-360 外形、碰撞和惯量。 -->
  <xacro:livox_mid360_link name="mid360_link"/>

  <xacro:fixed_joint
    name="mid360_joint"
    parent="gimbal_link"
    child="mid360_link"
    xyz="${mid360_x} ${mid360_y} 0"
    rpy="${mid360_rpy}"/>

  <!-- 四轮全向轮底盘，轮轴朝向 base_link 中心 -->
  <xacro:wheel name="wheel_fl" radius="${wheel_radius}" width="${wheel_width}" mass="${wheel_mass}"/>
  <xacro:fixed_joint name="wheel_fl_joint" parent="base_link" child="wheel_fl"
    xyz="${wheel_spacing} ${wheel_spacing} ${wheel_z}" rpy="1.5708 0 -0.7854"/>

  <xacro:wheel name="wheel_fr" radius="${wheel_radius}" width="${wheel_width}" mass="${wheel_mass}"/>
  <xacro:fixed_joint name="wheel_fr_joint" parent="base_link" child="wheel_fr"
    xyz="${wheel_spacing} -${wheel_spacing} ${wheel_z}" rpy="1.5708 0 -2.3562"/>

  <xacro:wheel name="wheel_rl" radius="${wheel_radius}" width="${wheel_width}" mass="${wheel_mass}"/>
  <xacro:fixed_joint name="wheel_rl_joint" parent="base_link" child="wheel_rl"
    xyz="-${wheel_spacing} ${wheel_spacing} ${wheel_z}" rpy="1.5708 0 0.7854"/>

  <xacro:wheel name="wheel_rr" radius="${wheel_radius}" width="${wheel_width}" mass="${wheel_mass}"/>
  <xacro:fixed_joint name="wheel_rr_joint" parent="base_link" child="wheel_rr"
    xyz="-${wheel_spacing} -${wheel_spacing} ${wheel_z}" rpy="1.5708 0 2.3562"/>

</robot>
