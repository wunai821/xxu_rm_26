<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- 全向轮宏：视觉模型来自 YePeOn7/ros2_omni_robot_sim，碰撞体保留为简化圆柱。 -->
  <xacro:macro name="wheel" params="name radius width mass material:='wheel_black'">
    <xacro:property name="mesh_radial_scale" value="${radius / 0.0285}"/>
    <xacro:property name="mesh_axial_scale" value="${width / 0.0276}"/>
    <xacro:property name="mesh_center_y" value="0.0012"/>

    <link name="${name}">
      <visual>
        <origin xyz="0 0 ${-mesh_center_y * mesh_axial_scale}" rpy="1.5708 0 0"/>
        <geometry>
          <mesh
            filename="package://xxu_description/meshes/ros2_omni_robot_sim/generic/omni_wheel.stl"
            scale="${mesh_radial_scale} ${mesh_axial_scale} ${mesh_radial_scale}"/>
        </geometry>
        <material name="${material}"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <cylinder radius="${radius}" length="${width}"/>
        </geometry>
      </collision>

      <inertial>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <mass value="${mass}"/>
        <inertia
          ixx="${mass * (3 * radius * radius + width * width) / 12}"
          ixy="0" ixz="0"
          iyy="${mass * (3 * radius * radius + width * width) / 12}"
          iyz="0"
          izz="${mass * radius * radius / 2}"/>
      </inertial>
    </link>
  </xacro:macro>

</robot>
