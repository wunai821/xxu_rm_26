<?xml version="1.0" ?>
<sdf version="1.9">
  <world name="complex_mapping">
    <physics name="3ms" type="dartsim">
      <max_step_size>0.003</max_step_size>
      <real_time_update_rate>1000.0</real_time_update_rate>
      <real_time_factor>1.0</real_time_factor>
      <dart>
        <collision_detector>bullet</collision_detector>
      </dart>
    </physics>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics">
      <engine>
        <filename>gz-physics-dartsim-plugin</filename>
      </engine>
    </plugin>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>
    <plugin filename="gz-sim-contact-system" name="gz::sim::systems::Contact"/>

    <light type="directional" name="sun">
      <cast_shadows>false</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>80 80</size>
            </plane>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>80 80</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.72 0.72 0.72 1</ambient>
            <diffuse>0.72 0.72 0.72 1</diffuse>
            <specular>0.15 0.15 0.15 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <model name="outer_north_wall">
      <static>true</static>
      <pose>0 6 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>14 0.18 1</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>14 0.18 1</size></box></geometry><material><diffuse>0.2 0.2 0.2 1</diffuse></material></visual>
      </link>
    </model>
    <model name="outer_south_wall">
      <static>true</static>
      <pose>0 -6 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>14 0.18 1</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>14 0.18 1</size></box></geometry><material><diffuse>0.2 0.2 0.2 1</diffuse></material></visual>
      </link>
    </model>
    <model name="outer_east_wall">
      <static>true</static>
      <pose>7 0 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.18 12 1</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.18 12 1</size></box></geometry><material><diffuse>0.2 0.2 0.2 1</diffuse></material></visual>
      </link>
    </model>
    <model name="outer_west_wall">
      <static>true</static>
      <pose>-7 0 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.18 12 1</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.18 12 1</size></box></geometry><material><diffuse>0.2 0.2 0.2 1</diffuse></material></visual>
      </link>
    </model>

    <model name="left_room_wall_upper">
      <static>true</static>
      <pose>-3.2 2.45 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.18 4.6 1</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.18 4.6 1</size></box></geometry><material><diffuse>0.3 0.3 0.32 1</diffuse></material></visual>
      </link>
    </model>
    <model name="left_room_wall_lower">
      <static>true</static>
      <pose>-3.2 -3.45 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.18 3.0 1</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.18 3.0 1</size></box></geometry><material><diffuse>0.3 0.3 0.32 1</diffuse></material></visual>
      </link>
    </model>
    <model name="right_room_wall_upper">
      <static>true</static>
      <pose>3.6 3.15 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.18 3.3 1</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.18 3.3 1</size></box></geometry><material><diffuse>0.3 0.3 0.32 1</diffuse></material></visual>
      </link>
    </model>
    <model name="right_room_wall_lower">
      <static>true</static>
      <pose>3.6 -3.15 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.18 3.3 1</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.18 3.3 1</size></box></geometry><material><diffuse>0.3 0.3 0.32 1</diffuse></material></visual>
      </link>
    </model>
    <model name="upper_corridor_wall">
      <static>true</static>
      <pose>0 2.1 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>5.6 0.18 1</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>5.6 0.18 1</size></box></geometry><material><diffuse>0.3 0.3 0.32 1</diffuse></material></visual>
      </link>
    </model>
    <model name="lower_corridor_wall_left">
      <static>true</static>
      <pose>-1.0 -2.0 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>2.6 0.18 1</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>2.6 0.18 1</size></box></geometry><material><diffuse>0.3 0.3 0.32 1</diffuse></material></visual>
      </link>
    </model>
    <model name="lower_corridor_wall_right">
      <static>true</static>
      <pose>2.5 -2.0 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>2.2 0.18 1</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>2.2 0.18 1</size></box></geometry><material><diffuse>0.3 0.3 0.32 1</diffuse></material></visual>
      </link>
    </model>

    <model name="island_box_1">
      <static>true</static>
      <pose>-5.0 3.8 0.35 0 0 0.35</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>1.3 0.7 0.7</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>1.3 0.7 0.7</size></box></geometry><material><diffuse>0.55 0.38 0.18 1</diffuse></material></visual>
      </link>
    </model>
    <model name="island_box_2">
      <static>true</static>
      <pose>5.0 -3.5 0.35 0 0 -0.45</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>1.2 0.9 0.7</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>1.2 0.9 0.7</size></box></geometry><material><diffuse>0.55 0.38 0.18 1</diffuse></material></visual>
      </link>
    </model>
    <model name="center_pillar">
      <static>true</static>
      <pose>0.4 0.1 0.6 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><cylinder><radius>0.45</radius><length>1.2</length></cylinder></geometry></collision>
        <visual name="visual"><geometry><cylinder><radius>0.45</radius><length>1.2</length></cylinder></geometry><material><diffuse>0.25 0.42 0.48 1</diffuse></material></visual>
      </link>
    </model>
    <model name="narrow_gate_post_left">
      <static>true</static>
      <pose>-0.55 -3.75 0.45 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.35 0.35 0.9</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.35 0.35 0.9</size></box></geometry><material><diffuse>0.48 0.26 0.26 1</diffuse></material></visual>
      </link>
    </model>
    <model name="narrow_gate_post_right">
      <static>true</static>
      <pose>0.65 -3.75 0.45 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.35 0.35 0.9</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.35 0.35 0.9</size></box></geometry><material><diffuse>0.48 0.26 0.26 1</diffuse></material></visual>
      </link>
    </model>
  </world>
</sdf>
